# Defaults need no API key. Export variables or use uvicorn --env-file .env.
APP_MODE=local
DATABASE_PATH=data/relay.db
LANGUAGE_MODE=guided
# Required in production mode; use a random value of at least 32 characters.
ADMIN_TOKEN=
# Optional natural-language interpretation. Never put these in frontend code.
# Set LANGUAGE_MODE=openai and choose a model supporting Responses structured output.
OPENAI_API_KEY=
OPENAI_MODEL=
